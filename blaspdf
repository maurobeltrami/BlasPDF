#!/bin/bash
# ==============================================================================
# blaspdf - Launcher Desktop Zero-Terminal (macOS Finder & Terminal)
# ==============================================================================
DIR="$(cd "$(dirname "$0")" && pwd)"

if [ -d "$DIR/BlasPDF.app" ]; then
    open "$DIR/BlasPDF.app"
elif [ -d "$DIR/src-tauri/target/debug/bundle/macos/BlasPDF.app" ]; then
    open "$DIR/src-tauri/target/debug/bundle/macos/BlasPDF.app"
elif [ -d "$DIR/src-tauri/target/release/bundle/macos/BlasPDF.app" ]; then
    open "$DIR/src-tauri/target/release/bundle/macos/BlasPDF.app"
else
    open -a "Google Chrome" "$DIR/src/index.html" 2>/dev/null || open "$DIR/src/index.html"
fi

# Se avviato con doppio click da Finder (che apre Terminale), chiudi automaticamente la finestra
if [ -n "$TERM_PROGRAM" ]; then
    (sleep 0.8 && osascript -e 'tell application "Terminal"
        repeat with w in (every window)
            if name of w contains "blaspdf" then
                close w
            end if
        end repeat
        if (count of windows) is 0 then
            quit
        end if
    end tell' &>/dev/null) &
fi
